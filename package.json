{
  "author": "yunzaijs",
  "bugs": "https://github.com/yunzaijs/alemonjs-load-yunzai/issues",
  "dependencies": {
    "@koa/multer": "^4.0.0",
    "classnames": "^2.5.1",
    "extract-zip": "^2.0.1",
    "isomorphic-git": "^1.37.4",
    "jsxp": "^1.4.0",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^14.0.0",
    "markdown-to-jsx": "^9.7.13",
    "md5": "^2.3.0",
    "multer": "^2.0.2"
  },
  "description": "yunzai-bot",
  "exports": {
    ".": "./lib/index.js",
    "./desktop": "./lib/desktop.js",
    "./package": "./package.json"
  },
  "keywords": [
    "alemonjs"
  ],
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "main": "./lib/index.js",
  "name": "alemonjs-load-yunzai",
  "files": [
    "lib",
    "dist",
    "LICENSE",
    "runtime/yarn",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yunzaijs/alemonjs-load-yunzai.git"
  },
  "scripts": {
    "app": "node index.js",
    "bundle": "yarn install && lvy build && yarn --cwd frontend install  && yarn --cwd frontend build",
    "dev": "lvy app.ts --serverPort 17187",
    "dev-fe": "yarn --cwd frontend dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts,.tsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js --fix --max-warnings=0",
    "precommit": "lint-staged",
    "start": "npx --yes pm2 startOrRestart pm2.config.cjs",
    "stop": "npx --yes pm2 stop pm2.config.cjs",
    "test": "yarn test:onebot-compat",
    "test:git": "lvy build && node --test --test-force-exit tests/git-operations.test.mjs",
    "test:onebot-compat": "lvy build && node --test --test-force-exit tests/onebot-compat.test.mjs tests/plugin-faults.test.mjs tests/plugin-events.test.mjs tests/command-output.test.mjs tests/media.test.mjs tests/bridge-context.test.mjs tests/api-result.test.mjs tests/renderer-compat.test.mjs",
    "view": "lvy app.ts --jsxp"
  },
  "type": "module",
  "version": "1.0.38",
  "alemonjs": {
    "config": [
      {
        "description": "GitHub 代理前缀",
        "name": "gh_proxy",
        "required": false,
        "rules": [
          {
            "message": "代理必须以http://或https://开头",
            "pattern": "^http://|^https://"
          },
          {
            "message": "代理格式不正确",
            "pattern": "^(http|https)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$"
          }
        ],
        "type": "string"
      },
      {
        "description": "Yunzai 仓库地址",
        "name": "yunzai_repo",
        "required": false,
        "rules": [
          {
            "message": "仓库地址必须以http://或https://开头",
            "pattern": "^http://|^https://"
          },
          {
            "message": "仓库地址格式不正确",
            "pattern": "^(http|https)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$"
          }
        ],
        "type": "string"
      },
      {
        "description": "miao-plugin 仓库地址",
        "name": "miao_plugin_repo",
        "required": false,
        "rules": [
          {
            "message": "仓库地址必须以http://或https://开头",
            "pattern": "^http://|^https://"
          },
          {
            "message": "仓库地址格式不正确",
            "pattern": "^(http|https)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$"
          }
        ],
        "type": "string"
      }
    ],
    "desktop": {
      "command": [
        {
          "command": "open.yunzai",
          "name": "yunzai"
        }
      ],
      "sidebars": [
        {
          "command": "open.yunzai",
          "name": "yunzai"
        }
      ]
    },
    "web": {
      "config": {
        "serverPort": true
      },
      "root": "dist"
    }
  }
}
